# Copiez ce fichier en `.env` : cp .env.example .env

# Clé d'API Mistral (à renseigner ; ne jamais la committer)
MISTRAL_API_KEY=

# Modèles Mistral
LLM_CHATBOT=mistral-small-latest     # le chatbot (ai.py, llm.chat)
LLM_CONTEXT=ministral-14b-latest     # contextualisation des chunks et descriptions des recettes

# Contextualisation automatique des documents ajoutés (appelle le LLM pour CHAQUE chunk : ça coûte des tokens !)
# AUTO_CONTEXTUALIZE=true          # false pour la désactiver
# AUTO_CONTEXT_MAX_CHUNKS=5000     # documents plus gros : ignorés (contextualisation manuelle possible)
# AUTO_CONTEXT_WORKERS=64          # appels au LLM en parallèle (le débit reste borné par la limite ci-dessous)
# LLM_REQUESTS_PER_MINUTE=500      # limite de requêtes/minute de votre clé Mistral ; le backend n'en dépasse jamais 95 %
#                                  # (et lit la vraie limite dans les en-têtes de Mistral) : mettez 60 si votre clé est limitée à 1/s

# Contexte donné au LLM pour chaque chunk : le chunk + N chunks avant et après, sans sortir de la section
# CONTEXT_NEIGHBORS=2
# CONTEXT_SECTION_LEVEL=3          # niveau de titre Markdown = « chapitre » (### par défaut)

# Ports côté machine : changez-les s'ils sont déjà utilisés
BACKEND_PORT=8010
FRONTEND_PORT=5180
# DB_PORT=5433
